# Particular Notions — online store environment variables.
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored; this template (.env.example) is committed.
#
# While building, use Square SANDBOX credentials. At go-live, swap SQUARE_ENV to
# "production" and paste the production credentials — no code changes needed.

# ---------------------------------------------------------------------------
# Square — card payments (Square Web Payments SDK + Payments API)
# ---------------------------------------------------------------------------

# Public base URL of the deployed site, e.g. https://particularnotions.com (no
# trailing slash). Used so order emails can show the real logo (email clients
# can't load localhost images). Leave blank locally — emails fall back to a text
# wordmark.
NEXT_PUBLIC_SITE_URL=

# "sandbox" while building, "production" at launch.
SQUARE_ENV=sandbox

# developer.squareup.com -> your app -> Credentials (pick Sandbox or Production
# to match SQUARE_ENV above), and the Locations tab for the location id.
#
# ACCESS_TOKEN is server-only (never exposed to the browser). APPLICATION_ID and
# LOCATION_ID are public identifiers — the server reads them and passes them to
# the checkout component for the browser Web Payments SDK, so no NEXT_PUBLIC_
# copies are needed.
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=

# ---------------------------------------------------------------------------
# Notifications — Twilio SendGrid (owner alert + customer confirmation email)
# ---------------------------------------------------------------------------

# app.sendgrid.com -> Settings -> API Keys (needs "Mail Send" permission).
SENDGRID_API_KEY=

# The "from" address on all emails. MUST be a verified Sender (or a verified
# domain) in SendGrid, or sends will be rejected.
ORDER_FROM_EMAIL=

# The inbox that receives a new-order alert for every order (the owner).
ORDER_ALERT_EMAIL=

# Reply-to on the customer's confirmation email (where their replies land).
CUSTOMER_REPLY_TO_EMAIL=

# ---------------------------------------------------------------------------
# Google reCAPTCHA v3 — bot protection on checkout
# ---------------------------------------------------------------------------
# Create keys at https://www.google.com/recaptcha/admin (choose "Score based v3"),
# add your domain(s) incl. localhost. The SITE key is public (shipped to the
# browser); the SECRET is server-only.
#
# Until RECAPTCHA_SECRET_KEY is set, checkout verification is skipped (so local
# dev works before keys exist). Set both to enforce it.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Minimum passing score, 0.0–1.0 (default 0.5). Lower = more lenient.
RECAPTCHA_MIN_SCORE=0.5
